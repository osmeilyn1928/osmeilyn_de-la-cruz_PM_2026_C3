
#include <stdio.h>

int main(void) {
    int i, n, numero, suma = 0;

    printf("Ingrese la cantidad de numeros: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        printf("Ingrese el numero %d: ", i);
     scanf("%d", &numero);

        if (numero > 0) {
            suma = suma + numero;
        }
    }

    printf("\nLa suma de los numeros positivos es: %d\n", suma);

    return 0;
}
